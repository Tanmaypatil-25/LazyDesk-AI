{
  "name": "lazydesk-ai",
  "version": "1.0.0",
  "description": "Privacy-first local AI document organizer powered by open-weight Gemma and Ollama for Hacktoberfest 2026 Week 3",
  "type": "module",
  "main": "server/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanmaypatil-25/LazyDesk-AI.git"
  },
  "bugs": {
    "url": "https://github.com/Tanmaypatil-25/LazyDesk-AI/issues"
  },
  "homepage": "https://github.com/Tanmaypatil-25/LazyDesk-AI#readme",
  "scripts": {
    "start": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "client:dev": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server:dev\" \"npm run client:dev\"",
    "build": "npm --prefix client run build",
    "test": "node --test server/tests/**/*.test.js",
    "install:all": "npm install && npm --prefix client install"
  },
  "keywords": [
    "hacktoberfest",
    "hacktoberfest-2026",
    "gemma",
    "gemma-3",
    "ollama",
    "open-source-ai",
    "mern",
    "document-organizer",
    "local-ai",
    "privacy-first"
  ],
  "author": "Tanmay Patil",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^8.7.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "pdfkit": "^0.20.2"
  }
}
